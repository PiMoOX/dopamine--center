---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Courses from '../components/Courses.astro';
import Podcast from '../components/Podcast.astro';
import Quote from '../components/Quote.astro';
import Journal from '../components/Journal.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout>
  <Header />
  
  <!-- ===== هیرو (همون قبلی) ===== -->
  <Hero />
  
  <!-- ===== اسلایدر بنر (زیر هیرو) ===== -->
  <section class="banner-slider py-8 px-4 bg-gradient-to-b from-white to-pink-50">
    <div class="max-w-6xl mx-auto relative" x-data="slider" role="region" aria-roledescription="carousel" aria-label="اسلایدر بنرها">
      <div class="bs-card relative overflow-hidden rounded-2xl shadow-2xl aspect-[16/9] select-none"
           @mouseenter="onEnter()" @mouseleave="onLeave()"
           @touchstart.passive="onTouchStart($event)" @touchend.passive="onTouchEnd($event)">
        <!-- اسلاید ۱: رفتار نوجوانان -->
        <div class="bs-slide absolute inset-0 z-10"
             :class="{ 'bs-on z-20': active === 0, 'bs-off': active !== 0 }"
             :aria-hidden="active !== 0 ? 'true' : 'false'">
          <img src="/images/teen-behavior-banner.png" alt="رفتار نوجوانان"
               class="bs-img w-full h-full object-cover" :class="{ 'bs-kb': active === 0 }">
        </div>
        <!-- اسلاید ۲: اعتماد به نفس در محیط کار -->
        <div class="bs-slide absolute inset-0 z-10"
             :class="{ 'bs-on z-20': active === 1, 'bs-off': active !== 1 }"
             :aria-hidden="active !== 1 ? 'true' : 'false'">
          <img src="/images/workplace-confidence-banner.png" alt="اعتماد به نفس در محیط کار"
               class="bs-img w-full h-full object-cover" :class="{ 'bs-kb': active === 1 }">
        </div>
        <!-- اسلاید ۳: روانشناسی خانواده -->
        <div class="bs-slide absolute inset-0 z-10"
             :class="{ 'bs-on z-20': active === 2, 'bs-off': active !== 2 }"
             :aria-hidden="active !== 2 ? 'true' : 'false'">
          <img src="/images/family-psychology-banner.webp" alt="روانشناسی خانواده"
               class="bs-img w-full h-full object-cover" :class="{ 'bs-kb': active === 2 }">
        </div>
        <!-- اسلاید ۴: درک والدین و کودک -->
        <div class="bs-slide absolute inset-0 z-10"
             :class="{ 'bs-on z-20': active === 3, 'bs-off': active !== 3 }"
             :aria-hidden="active !== 3 ? 'true' : 'false'">
          <img src="/images/parent-child-understanding-banner.webp" alt="درک والدین و کودک"
               class="bs-img w-full h-full object-cover" :class="{ 'bs-kb': active === 3 }">
        </div>

        <!-- دکمه‌های قبلی و بعدی (در سایت فارسی RTL اسلاید «بعدی» سمت چپ قرار می‌گیرد) -->
        <button type="button" @click="userNext()" aria-label="اسلاید بعدی"
                class="absolute left-4 top-1/2 -translate-y-1/2 z-30 bg-white/30 hover:bg-white/60 text-white p-3 rounded-full shadow-lg backdrop-blur-sm transition-all duration-200 hover:scale-[1.08]">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
        </button>
        <button type="button" @click="userPrev()" aria-label="اسلاید قبلی"
                class="absolute right-4 top-1/2 -translate-y-1/2 z-30 bg-white/30 hover:bg-white/60 text-white p-3 rounded-full shadow-lg backdrop-blur-sm transition-all duration-200 hover:scale-[1.08]">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </button>

        <!-- نقاط راهنما -->
        <div class="absolute bottom-6 left-1/2 -translate-x-1/2 flex gap-3 z-30">
          <button type="button" @click="goTo(0)" aria-label="اسلاید ۱" :aria-current="active === 0 ? 'true' : 'false'"
                  class="bs-dot" :class="{ 'bs-dot-on': active === 0 }"><span class="bs-fill" :class="{ 'bs-fill-on': active === 0, 'bs-run': playing }"></span></button>
          <button type="button" @click="goTo(1)" aria-label="اسلاید ۲" :aria-current="active === 1 ? 'true' : 'false'"
                  class="bs-dot" :class="{ 'bs-dot-on': active === 1 }"><span class="bs-fill" :class="{ 'bs-fill-on': active === 1, 'bs-run': playing }"></span></button>
          <button type="button" @click="goTo(2)" aria-label="اسلاید ۳" :aria-current="active === 2 ? 'true' : 'false'"
                  class="bs-dot" :class="{ 'bs-dot-on': active === 2 }"><span class="bs-fill" :class="{ 'bs-fill-on': active === 2, 'bs-run': playing }"></span></button>
          <button type="button" @click="goTo(3)" aria-label="اسلاید ۴" :aria-current="active === 3 ? 'true' : 'false'"
                  class="bs-dot" :class="{ 'bs-dot-on': active === 3 }"><span class="bs-fill" :class="{ 'bs-fill-on': active === 3, 'bs-run': playing }"></span></button>
        </div>
      </div>
    </div>
  </section>

  <style>
    /* استایل و انیمیشن‌های اسلایدر بنر */
    .bs-card { touch-action: pan-y; }
    .bs-slide { transition: opacity 950ms ease-in-out; }
    .bs-on { opacity: 1; }
    .bs-off { opacity: 0; }
    .bs-img { transform: scale(1.06); }
    .bs-kb { animation: bsKenBurns 7s cubic-bezier(0.22, 0.61, 0.36, 1) both; }
    @keyframes bsKenBurns { 0% { transform: scale(1.06); } 100% { transform: scale(1.0); } }
    .bs-dot { position: relative; width: 12px; height: 12px; border-radius: 9999px; background: rgba(255,255,255,0.45); overflow: hidden; cursor: pointer; padding: 0; border: 0; transition: width 300ms ease, background-color 300ms ease; }
    .bs-dot-on { width: 32px; background: rgba(255,255,255,0.3); }
    .bs-fill { position: absolute; inset: 0; border-radius: inherit; background: #fff; transform: scaleX(0); transform-origin: right; opacity: 0; }
    .bs-fill-on { opacity: 0.95; animation: bsFill 5.5s linear forwards; animation-play-state: paused; }
    .bs-fill-on.bs-run { animation-play-state: running; }
    @keyframes bsFill { from { transform: scaleX(0); } to { transform: scaleX(1); } }
    @media (prefers-reduced-motion: reduce) {
      .bs-kb { animation: none; }
      .bs-img { transform: none; }
      .bs-slide { transition-duration: 150ms; }
      .bs-fill-on { animation: none; opacity: 0; }
    }
  </style>

  <div class="glow-divider"></div>
  <Services />
  <Courses />
  <Podcast />
  <Quote />
  <Journal />
  <About />
  <Contact />
  <Footer />
</BaseLayout>

<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

<script>
  document.addEventListener('alpine:init', () => {
    Alpine.data('slider', () => ({
      active: 0,
      count: 4,
      duration: 5500,
      timer: null,
      hovered: false,
      reduced: false,
      playing: false,
      touchX: null,
      init() {
        this.reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        this.start();
        document.addEventListener('visibilitychange', () => {
          if (document.hidden) { this.stop(); } else { this.start(); }
        });
      },
      start() {
        if (this.timer || this.hovered || document.hidden || this.reduced) return;
        this.playing = true;
        this.timer = setInterval(() => {
          this.active = (this.active + 1) % this.count;
        }, this.duration);
      },
      stop() {
        clearInterval(this.timer);
        this.timer = null;
        this.playing = false;
      },
      onEnter() {
        if (window.matchMedia('(hover: hover)').matches) { this.hovered = true; this.stop(); }
      },
      onLeave() { this.hovered = false; this.start(); },
      next() { this.active = (this.active + 1) % this.count; },
      prev() { this.active = (this.active - 1 + this.count) % this.count; },
      userNext() { this.next(); this.restart(); },
      userPrev() { this.prev(); this.restart(); },
      goTo(i) {
        if (this.active === i) return;
        this.active = i;
        this.restart();
      },
      restart() { this.stop(); this.start(); },
      onTouchStart(e) { this.touchX = e.touches[0].clientX; },
      onTouchEnd(e) {
        if (this.touchX === null) return;
        const dx = e.changedTouches[0].clientX - this.touchX;
        this.touchX = null;
        if (Math.abs(dx) < 50) return;
        // در RTL اسلاید بعدی سمت چپ است: کشیدن انگشت به سمت راست، اسلاید فعلی را کنار می‌زند
        if (dx > 0) { this.next(); } else { this.prev(); }
        this.restart();
      },
    }));
  });
</script>